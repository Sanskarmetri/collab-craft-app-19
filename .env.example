# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_PROJECT_ID="your_project_id_here"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_anon_key_here"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Optional: Error tracking and analytics
# SENTRY_DSN="your_sentry_dsn_here"

# SECURITY NOTE:
# - Never commit the actual .env file to version control
# - The PUBLISHABLE_KEY (anon key) is safe to expose on the client
# - All sensitive operations should be protected by Row Level Security (RLS)
# - Edge function secrets are managed separately in Supabase dashboard
